# Wameir contact-form backend — environment variable NAMES only.
# Real values live ONLY in the Cloudflare Pages environment settings, scoped per
# environment (preview vs production). Never commit real values to the repo, the
# client bundle, or commit history (spec §11, §14). Copy this file to .env.local for
# local development (.env.local / .env are git-ignored).

# Neon serverless Postgres — pooled connection string (edge HTTP driver).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend transactional email (HTTP API). Notifications go to hello@wameir.com.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender the notification email is sent FROM (must be a Resend-verified domain).
RESEND_FROM="Wameir Site <notifications@wameir.com>"
LEADS_NOTIFY_TO="hello@wameir.com"

# Cloudflare Turnstile (spam protection). Site key is public (sent to the browser);
# the secret key is verified server-side only and must never reach the client.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x0000000000000000000000"
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000000000"

# Set to "true" ONLY after the privacy notice is live and counsel-reviewed (§12).
# While unset/false the API route refuses to store leads — a hard launch gate.
CONTACT_FORM_ENABLED="false"

# Public (build-time) mirror: when "true" the site renders the real contact form;
# otherwise it shows a clean "email us" CTA instead of a form that can't submit.
# Set both to "true" together at launch.
NEXT_PUBLIC_CONTACT_FORM_ENABLED="false"
